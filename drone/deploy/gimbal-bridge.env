# gimbal-bridge settings. Installed to /etc/drone-stack/gimbal-bridge.env.
# Every variable maps to a command-line flag (GIMBAL_HOST = -gimbal-host).

# mavlink-router sends to this address (see [UdpEndpoint gimbal-bridge]).
MAVLINK=udp-server:127.0.0.1:14556

# Skydroid C12 on the onboard LAN.
GIMBAL_HOST=192.168.144.108
GIMBAL_PORT=5000

# Local UDP port for C12 traffic. 5001 while the old drone-agent still holds
# 5000; install.sh switches this to 5000 in "final" mode.
LOCAL_PORT=5001

# legacy = 0.1 deg/s units (what the fleet uses today); apk = Skydroid app units.
SPEED_ENCODING=legacy

# Advertised to ground stations via VIDEO_STREAM_INFORMATION (QGC shows these).
# __TAILSCALE_IP__ is replaced by install.sh.
VIDEO_VISIBLE=rtsp://__TAILSCALE_IP__:8554/skydroid_camera
VIDEO_THERMAL=rtsp://__TAILSCALE_IP__:8554/skydroid_thermal

LOG_LEVEL=info
