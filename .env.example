# Drone host and name are supplied via URL query parameters:
#   http://localhost:8091/?host=100.91.79.23&name=kutwali
# The name is used as a prefix for go2rtc stream names:
#   kutwali_camera, kutwali_thermal

# Centralized go2rtc server URL
GO2RTC_URL=https://cams.drone.starwatch.bb7fab11.sslip.io

# Centralized go2rtc RTSP URL (optional, defaults to rtsp://<go2rtc_host>:8554)
# GO2RTC_RTSP_URL=rtsp://cams.drone.starwatch.bb7fab11.sslip.io:8554

# Recording ingest mode: rtsp | mp4 | hls (default: rtsp)
# mp4 = ingest over the same HTTPS port as browser playback (api/stream.mp4) —
#       use when the go2rtc RTSP port is unreachable
# hls = ingest via api/stream.m3u8 over HTTPS (higher latency)
# GO2RTC_INGEST_MODE=mp4

# Directory/path to store server-side dual-feed recordings (default: current directory/recording)
# RECORDING_PATH=recordings

# Port for drone-agent on each Pi (usually unchanged)
AGENT_PORT=8080

# This viewer app
VIEWER_HOST=0.0.0.0
VIEWER_PORT=8091

